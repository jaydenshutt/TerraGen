# Generated by TerraGen — GitLab CI starter
stages:
  - validate
  - plan
  # - apply

default:
  image:
    name: hashicorp/terraform:1.9
    entrypoint: [""]

variables:
  TF_IN_AUTOMATION: "true"

fmt:
  stage: validate
  script:
    - terraform fmt -check -recursive

validate:
  stage: validate
  script:
    - terraform init -backend=false
    - terraform validate

plan:
  stage: plan
  script:
    - terraform init -backend=false
    - terraform plan -input=false -out=plan.tfplan
  artifacts:
    paths:
      - plan.tfplan
    expire_in: 7 days
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH

