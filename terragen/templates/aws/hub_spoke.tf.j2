# -----------------------------------------------------------------------------
# Hub-and-spoke — Transit Gateway (default) or VPC peering
# Hub CIDR: {{ hub_cidr or vpc_cidr }} | Spokes: {{ spoke_count }}
# Connectivity: {{ hub_spoke_connectivity }}
# -----------------------------------------------------------------------------

locals {
  hub_spoke_name = "${local.name_prefix}-hub"
  spoke_cidrs    = {{ spoke_cidrs | tf }}
}

# --- Spoke VPCs --------------------------------------------------------------

resource "aws_vpc" "spoke" {
  count = {{ spoke_count }}

  cidr_block           = local.spoke_cidrs[count.index]
  enable_dns_support   = true
  enable_dns_hostnames = true
{% if enable_ipv6 %}
  assign_generated_ipv6_cidr_block = true
{% endif %}

  tags = merge(var.tags, {
    Name = "${local.name_prefix}-spoke-${count.index + 1}"
    Tier = "spoke"
  })
}

resource "aws_subnet" "spoke_private" {
  count = {{ spoke_count }} * var.az_count

  vpc_id            = aws_vpc.spoke[floor(count.index / var.az_count)].id
  cidr_block        = cidrsubnet(local.spoke_cidrs[floor(count.index / var.az_count)], 4, count.index % var.az_count)
  availability_zone = local.azs[count.index % var.az_count]
{% if enable_ipv6 %}
  ipv6_cidr_block                 = cidrsubnet(aws_vpc.spoke[floor(count.index / var.az_count)].ipv6_cidr_block, 8, count.index % var.az_count)
  assign_ipv6_address_on_creation = true
{% endif %}

  tags = merge(var.tags, {
    Name = "${local.name_prefix}-spoke-${floor(count.index / var.az_count) + 1}-private-${(count.index % var.az_count) + 1}"
    Tier = "spoke-private"
  })
}

resource "aws_route_table" "spoke" {
  count  = {{ spoke_count }}
  vpc_id = aws_vpc.spoke[count.index].id

  tags = merge(var.tags, {
    Name = "${local.name_prefix}-spoke-${count.index + 1}-rt"
  })
}

resource "aws_route_table_association" "spoke_private" {
  count = {{ spoke_count }} * var.az_count

  subnet_id      = aws_subnet.spoke_private[count.index].id
  route_table_id = aws_route_table.spoke[floor(count.index / var.az_count)].id
}

{% if hub_spoke_connectivity == "tgw" %}
# --- Transit Gateway ---------------------------------------------------------

resource "aws_ec2_transit_gateway" "hub" {
  description                     = "${local.name_prefix} hub TGW"
  default_route_table_association = "enable"
  default_route_table_propagation = "enable"
  dns_support                     = "enable"
  vpn_ecmp_support                = "enable"

  tags = merge(var.tags, {
    Name = "${local.name_prefix}-tgw"
  })
}

resource "aws_ec2_transit_gateway_vpc_attachment" "hub" {
  subnet_ids         = aws_subnet.private[*].id
  transit_gateway_id = aws_ec2_transit_gateway.hub.id
  vpc_id             = aws_vpc.main.id

  tags = merge(var.tags, {
    Name = "${local.name_prefix}-tgw-hub"
  })
}

resource "aws_ec2_transit_gateway_vpc_attachment" "spoke" {
  count = {{ spoke_count }}

  subnet_ids = [
    for i in range(var.az_count) : aws_subnet.spoke_private[count.index * var.az_count + i].id
  ]
  transit_gateway_id = aws_ec2_transit_gateway.hub.id
  vpc_id             = aws_vpc.spoke[count.index].id

  tags = merge(var.tags, {
    Name = "${local.name_prefix}-tgw-spoke-${count.index + 1}"
  })
}

# One route per (private RT × spoke) so every AZ private table can reach spokes
resource "aws_route" "hub_to_spokes" {
  count = {{ spoke_count }} * var.az_count

  route_table_id         = aws_route_table.private[count.index % var.az_count].id
  destination_cidr_block = local.spoke_cidrs[floor(count.index / var.az_count)]
  transit_gateway_id     = aws_ec2_transit_gateway.hub.id
}

resource "aws_route" "spoke_default_via_tgw" {
  count = {{ spoke_count }}

  route_table_id         = aws_route_table.spoke[count.index].id
  destination_cidr_block = "0.0.0.0/0"
  transit_gateway_id     = aws_ec2_transit_gateway.hub.id
}

resource "aws_route" "spoke_to_hub" {
  count = {{ spoke_count }}

  route_table_id         = aws_route_table.spoke[count.index].id
  destination_cidr_block = var.vpc_cidr
  transit_gateway_id     = aws_ec2_transit_gateway.hub.id
}

output "transit_gateway_id" {
  value = aws_ec2_transit_gateway.hub.id
}

{% else %}
# --- VPC Peering (simpler / cheaper alternative) -----------------------------

resource "aws_vpc_peering_connection" "hub_spoke" {
  count = {{ spoke_count }}

  vpc_id      = aws_vpc.main.id
  peer_vpc_id = aws_vpc.spoke[count.index].id
  auto_accept = true

  tags = merge(var.tags, {
    Name = "${local.name_prefix}-peer-spoke-${count.index + 1}"
  })
}

resource "aws_route" "hub_to_spoke_peer" {
  count = {{ spoke_count }} * var.az_count

  route_table_id            = aws_route_table.private[count.index % var.az_count].id
  destination_cidr_block    = local.spoke_cidrs[floor(count.index / var.az_count)]
  vpc_peering_connection_id = aws_vpc_peering_connection.hub_spoke[floor(count.index / var.az_count)].id
}

resource "aws_route" "spoke_to_hub_peer" {
  count = {{ spoke_count }}

  route_table_id            = aws_route_table.spoke[count.index].id
  destination_cidr_block    = var.vpc_cidr
  vpc_peering_connection_id = aws_vpc_peering_connection.hub_spoke[count.index].id
}
{% endif %}

output "spoke_vpc_ids" {
  value = aws_vpc.spoke[*].id
}

output "spoke_cidrs" {
  value = local.spoke_cidrs
}
