# Environment root: {{ environment }}
# Calls shared modules generated by TerraGen (HashiCorp-style composition)

module "network" {
  source = "{{ module_source }}"

  project     = {{ project | tf }}
  environment = {{ environment | tf }}
  region      = {{ region | tf }}
  vpc_cidr    = {{ vpc_cidr | tf }}
  az_count    = {{ az_count }}
  nat_mode    = {{ nat_mode | tf }}

  public_subnets   = {{ public_subnets | tf }}
  private_subnets  = {{ private_subnets | tf }}
  isolated_subnets = {{ isolated_subnets | tf }}

  enable_flow_logs            = {{ enable_flow_logs | tf }}
  enable_vpc_endpoints        = {{ enable_vpc_endpoints | tf }}
  enable_interface_endpoints  = {{ enable_interface_endpoints | tf }}
  interface_endpoints         = {{ interface_endpoints | tf }}
  create_public_subnets       = {{ create_public_subnets | tf }}
  enable_isolated_subnets     = {{ enable_isolated_subnets | tf }}
  enable_eks_subnet_tags      = {{ enable_eks_subnet_tags | tf }}
  enable_gke_secondary_ranges = {{ enable_gke_secondary_ranges | tf }}
  gke_pod_cidrs               = {{ gke_pod_cidrs | tf }}
  gke_service_cidrs           = {{ gke_service_cidrs | tf }}
  enable_bastion_sg           = {{ enable_bastion_sg | tf }}
  enable_nsg_defaults         = {{ enable_nsg_defaults | tf }}
  enable_ipv6                 = {{ enable_ipv6 | tf }}
  # Cluster lives in modules/cluster when enable_cluster - not inside network
  enable_cluster              = false
  cluster_name                = {{ cluster_name | tf }}
  enable_hub_spoke            = {{ enable_hub_spoke | tf }}
  ssh_cidrs                   = {{ ssh_cidrs | tf }}
  tags                        = {{ tags | tf }}
{% if cloud == "gcp" %}
  gcp_project_id              = {{ gcp_project | tf }}
{% endif %}
{% if cloud == "azure" and azure_subscription_id %}
  azure_subscription_id       = {{ azure_subscription_id | tf }}
{% endif %}
}

{% if enable_cluster %}
module "cluster" {
  source = "../../modules/cluster"

  project     = {{ project | tf }}
  environment = {{ environment | tf }}
  region      = {{ region | tf }}
  tags        = {{ tags | tf }}
  cluster_name = {{ cluster_name | tf }}

{% if cloud == "aws" %}
  vpc_id                = module.network.vpc_id
  private_subnet_ids    = module.network.private_subnet_ids
  public_subnet_ids     = module.network.public_subnet_ids
  app_security_group_id = module.network.default_security_group_id
{% elif cloud == "gcp" %}
  gcp_project_id      = {{ gcp_project | tf }}
  network_name        = module.network.network_name
  private_subnet_name = module.network.private_subnet_names[0]
{% elif cloud == "azure" %}
  resource_group_name = module.network.resource_group_name
  location            = {{ region | tf }}
  vnet_id             = module.network.vnet_id
  private_subnet_id   = module.network.private_subnet_ids[0]
{% endif %}

  depends_on = [module.network]
}
{% endif %}
