# -----------------------------------------------------------------------------
# Azure Kubernetes Service (AKS)
# Blueprint: {{ blueprint }}
{% if cluster_as_module %}# Module: modules/cluster (network provided via variables)
{% else %}# Flat layout — uses VNet/subnets from this root module
{% endif %}# -----------------------------------------------------------------------------

{% if cluster_as_module %}
locals {
  name_prefix          = "${var.project}-${var.environment}"
  aks_location         = var.location
  aks_rg_name          = var.resource_group_name
  aks_private_subnet   = var.private_subnet_id
  aks_vnet_id          = var.vnet_id
}
{% else %}
locals {
  aks_location       = azurerm_resource_group.main.location
  aks_rg_name        = azurerm_resource_group.main.name
  aks_private_subnet = azurerm_subnet.private[0].id
  aks_vnet_id        = azurerm_virtual_network.main.id
}
{% endif %}

resource "azurerm_kubernetes_cluster" "main" {
  name                = {{ cluster_name | tf }}
  location            = local.aks_location
  resource_group_name = local.aks_rg_name
  dns_prefix          = "${var.project}${var.environment}"
  kubernetes_version        = {{ cluster_version | tf }}

  default_node_pool {
    name                = "system"
    vm_size             = {{ node_instance_type | tf }}
    # With enable_auto_scaling, use min/max only (avoid node_count conflicts on azurerm 3.x+)
    min_count           = {{ node_min_size }}
    max_count           = {{ node_max_size }}
    enable_auto_scaling = true
    vnet_subnet_id      = local.aks_private_subnet
    type                = "VirtualMachineScaleSets"
  }

  identity {
    type = "SystemAssigned"
  }

  network_profile {
    network_plugin    = "azure"
    load_balancer_sku = "standard"
    outbound_type     = "loadBalancer"
  }

  role_based_access_control_enabled = true

  tags = var.tags
{% if not cluster_as_module %}

  depends_on = [
    azurerm_subnet.private,
  ]
{% endif %}
}

# Allow AKS to manage networking on the VNet
resource "azurerm_role_assignment" "aks_network" {
  scope                = local.aks_vnet_id
  role_definition_name = "Network Contributor"
  principal_id         = azurerm_kubernetes_cluster.main.identity[0].principal_id
}

output "aks_cluster_name" {
  value = azurerm_kubernetes_cluster.main.name
}

output "aks_cluster_id" {
  value = azurerm_kubernetes_cluster.main.id
}

output "aks_kube_config_raw" {
  value     = azurerm_kubernetes_cluster.main.kube_config_raw
  sensitive = true
}

output "aks_fqdn" {
  value = azurerm_kubernetes_cluster.main.fqdn
}
