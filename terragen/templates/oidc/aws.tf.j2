# -----------------------------------------------------------------------------
# GitHub Actions → AWS IAM OIDC (no long-lived keys)
# Apply once with privileged credentials, then reference the role ARN in CI.
# Repository subject: repo:{{ github_repository }}:*
# -----------------------------------------------------------------------------

terraform {
  required_version = "{{ terraform_version }}"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "{{ provider_version_aws }}"
    }
  }
}

provider "aws" {
  region = "{{ region }}"
}

data "aws_caller_identity" "current" {}

resource "aws_iam_openid_connect_provider" "github" {
  url = "https://token.actions.githubusercontent.com"

  client_id_list = ["sts.amazonaws.com"]

  # GitHub Actions OIDC thumbprint (update if GitHub rotates)
  thumbprint_list = ["ffffffffffffffffffffffffffffffffffffffff"]

  tags = {
    Project   = "{{ project }}"
    ManagedBy = "TerraGen"
    Purpose   = "github-actions-oidc"
  }
}

data "aws_iam_policy_document" "gha_assume" {
  statement {
    actions = ["sts:AssumeRoleWithWebIdentity"]
    effect  = "Allow"

    principals {
      type        = "Federated"
      identifiers = [aws_iam_openid_connect_provider.github.arn]
    }

    condition {
      test     = "StringEquals"
      variable = "token.actions.githubusercontent.com:aud"
      values   = ["sts.amazonaws.com"]
    }

    condition {
      test     = "StringLike"
      variable = "token.actions.githubusercontent.com:sub"
      values   = ["repo:{{ github_repository }}:*"]
    }
  }
}

resource "aws_iam_role" "gha_terraform" {
  name               = "{{ project }}-gha-terraform"
  assume_role_policy = data.aws_iam_policy_document.gha_assume.json

  tags = {
    Project   = "{{ project }}"
    ManagedBy = "TerraGen"
  }
}

# Start with PowerUser; tighten to least-privilege for production.
resource "aws_iam_role_policy_attachment" "gha_poweruser" {
  role       = aws_iam_role.gha_terraform.name
  policy_arn = "arn:aws:iam::aws:policy/PowerUserAccess"
}

output "role_arn" {
  description = "Set as GitHub secret / variable AWS_ROLE_ARN"
  value       = aws_iam_role.gha_terraform.arn
}

output "github_repository" {
  value = "{{ github_repository }}"
}
